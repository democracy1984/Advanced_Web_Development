{% extends 'layout.twig' %}

{% block content %}
    {% if flashSuccess %}
        <div class="alert alert-success">{{ flashSuccess }}</div>
    {% endif %}

    {% if flashError %}
        <div class="alert alert-error">{{ flashError }}</div>
    {% endif %}

    {% if errors.form is defined %}
        <div class="alert alert-error">{{ errors.form }}</div>
    {% endif %}

    <section class="panel">
        <h2>Список рецептов</h2>
        <p>Всего рецептов: {{ stats.total }}. Среднее время приготовления: {{ stats.average|format_duration }}.</p>

        <div class="table-wrap">
            <table class="recipes-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Название</th>
                        <th>Автор</th>
                        <th>Категория</th>
                        <th>Сложность</th>
                        <th>Время</th>
                        <th>Создано</th>
                        <th>Теги</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    {% for recipe in recipes %}
                        <tr>
                            <td>{{ recipe.id }}</td>
                            <td><strong>{{ recipe.title }}</strong></td>
                            <td>{{ recipe.author }}</td>
                            <td><span class="badge badge-category">{{ recipe.category }}</span></td>
                            <td>
                                <span class="badge badge-{{ recipe.difficulty }}">
                                    {{ difficulties[recipe.difficulty] ?? recipe.difficulty }}
                                </span>
                            </td>
                            <td>{{ recipe.prepTime|format_duration }}</td>
                            <td>{{ recipe.createdAt|date('d.m.Y') }}</td>
                            <td>
                                {% for tag in recipe.tags %}
                                    <span class="tag">{{ tags[tag] ?? tag }}</span>
                                {% endfor %}
                                {% if recipe.tags is empty %}
                                    <span class="muted">—</span>
                                {% endif %}
                            </td>
                            <td>
                                <a class="btn btn-secondary" href="edit.php?id={{ recipe.id }}&engine={{ engine }}">Редактировать</a>
                                <form method="post" action="index.php?engine={{ engine }}" style="display:inline-block; margin-top:6px;">
                                    <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                                    <input type="hidden" name="action" value="delete">
                                    <input type="hidden" name="id" value="{{ recipe.id }}">
                                    <button type="submit" class="btn btn-danger" onclick="return confirm('Удалить рецепт?')">Удалить</button>
                                </form>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="9">
                                <details>
                                    <summary>Ингредиенты и приготовление</summary>
                                    <div class="details">
                                        <p><strong>Ингредиенты:</strong><br>{{ recipe.ingredients|nl2br }}</p>
                                        <p><strong>Приготовление:</strong><br>{{ recipe.instructions|nl2br }}</p>
                                        <p class="meta">Обновлено: {{ recipe.updatedAt|date('d.m.Y') }}</p>
                                    </div>
                                </details>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="9" class="empty">Рецептов пока нет. Добавьте первый!</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}
