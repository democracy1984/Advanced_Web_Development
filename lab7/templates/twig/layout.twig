<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title|default('Рецепты') }}</title>
    <link rel="stylesheet" href="/templates/style.css">
</head>
<body>

<header>
    <div class="header-inner">
        <p class="eyebrow">Advanced Web Development · Лабораторная работа №7</p>
        <h1>{{ title|default('Управление рецептами') }}</h1>
        <p class="subtitle">PDO, SQLite, шаблоны и CRUD</p>
    </div>
    <nav>
        <a href="index.php?engine={{ engine }}{% if page %}&page={{ page }}{% endif %}">Список рецептов</a>
        <a href="index.php?page=form&engine={{ engine }}{% if page %}&page={{ page }}{% endif %}">Добавить рецепт</a>
        <span class="engine-switch">
            Шаблон:
            <a href="?engine=native{% if page %}&page={{ page }}{% endif %}" class="{{ engine == 'native' ? 'active' : '' }}">PHP</a>
            <a href="?engine=twig{% if page %}&page={{ page }}{% endif %}" class="{{ engine == 'twig' ? 'active' : '' }}">Twig</a>
        </span>
    </nav>
</header>

<main class="container">
    {% block content %}{% endblock %}
</main>

<footer>
    <p>&copy; {{ "now"|date('Y') }} Лабораторная работа №7. Курс Advanced Web Development.</p>
</footer>

</body>
</html>
